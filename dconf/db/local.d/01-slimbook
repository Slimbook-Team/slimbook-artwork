[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0]
binding = '<Control>space'
command = 'ulauncher-toggle'
name = 'ulauncher'

[org/gnome/desktop/app-folders/folders/Utility]
categories=['Utility']
name = 'Accessories'
translate = true

[org/gnome/desktop/app-folders/folders/Office]
categories=['Office']
name = 'Office'
translate = true

[org/gnome/shell/extensions/dash-to-panel]
group-apps = false
hide-overview-on-startup = true
show-apps-icon-file = '/usr/share/pixmaps/slimbook-distributor-logo.png'
animate-appicon-hover = false
group-apps-underline-unfocused = false
group-apps-use-launchers = true
extension-version = 9999

[org/gnome/shell/extensions/lockkeys]
style = 'show-hide'
capslock-indicator = 'when-active'
numlock-indicator = 'when-active'

[org/gnome/shell/extensions/caffeine]
toggle-state = true
user-enabled = true

[org/gnome/shell/extensions/status-area-horizontal-spacing]
hpadding = 3

[io/missioncenter/MissionCenter]
performance-page-cpu-graph = 2
